{
  "ReverseProxy": {
    "Routes": {
      "products_route": {
        "ClusterId": "products_cluster",
        "Match": {
          "Path": "/api/Products/{**catch-all}"
        }
      },
      "auth_route": {
        "ClusterId": "auth_cluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "products_cluster": {
        "Destinations": {
          "products": {
            "Address": "https://localhost:5048/"
          }
        }
      },
      "auth_cluster": {
        "Destinations": {
          "auth": {
            "Address": "https://localhost:5048/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}